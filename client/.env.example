# ============================================================
# Skill X — Frontend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# All variables MUST be prefixed with VITE_ to be exposed in
# the React/Vite build.
#
# DO NOT put secrets here — these values are bundled into the
# browser JavaScript and are publicly visible.
# ============================================================

# Backend API base URL (no trailing slash)
# Development (using Vite proxy):  leave empty → proxy handles it
# Production (Vercel):             https://your-backend.onrender.com
VITE_API_URL=

# Backend Socket.IO URL (no trailing slash)
# Usually the same as VITE_API_URL
# Development (using Vite proxy):  leave empty → proxy handles it
# Production (Vercel):             https://your-backend.onrender.com
VITE_SOCKET_URL=
