# ===========================
# Skill X — Environment Variables
# ===========================
# Copy this file to .env and fill in your values.
#
# ┌──────────────────────────────────────────────────┐
# │  FRONTEND (client/)  →  Deploy on Vercel         │
# │  BACKEND  (server/)  →  Deploy on Render/Railway │
# │  DATABASE            →  MongoDB Atlas            │
# └──────────────────────────────────────────────────┘

# ============================================================
# FRONTEND — set these as Vercel Environment Variables
# (prefixed with VITE_ so Vite exposes them to the browser)
# ============================================================

# Backend URL (no trailing slash)
# e.g. https://skillx-api.onrender.com
VITE_API_URL=

# Socket.IO URL — same as VITE_API_URL in most cases
VITE_SOCKET_URL=

# ============================================================
# BACKEND — set these as Render / Railway Environment Variables
# ============================================================

# --- Server ---
NODE_ENV=production
PORT=5000

# --- MongoDB Atlas ---
MONGODB_URI=

# --- JWT ---
JWT_SECRET=your-strong-random-secret-change-in-production
JWT_EXPIRES_IN=7d

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match the callback URL registered in Google Cloud Console
GOOGLE_CALLBACK_URL=https://your-backend.onrender.com/api/auth/google/callback

# --- Client URL (for CORS + OAuth redirect) ---
# Your Vercel frontend URL (no trailing slash)
CLIENT_URL=https://your-frontend.vercel.app

# --- Email (SMTP) — optional, for password reset ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# --- File Storage ---
UPLOAD_DIR=uploads
# For S3 (recommended for production):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=

# --- WebRTC TURN (optional, improves cross-network call reliability) ---
# TURN_SERVER_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=
